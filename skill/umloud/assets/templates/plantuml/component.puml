@startuml
' umLoud template — component diagram
title <System> — components
skinparam componentStyle uml2
component "Client" as Client
component "Service" as Svc {
  component "Part A" as PA
  component "Part B" as PB
  portin " " as p
}
() "ProvidedApi" as Api
() "RequiredApi" as Req
component "External" as Ext
Client --( Api
p - Api
p --> PA
PA ..> PB
PB --( Req
Ext - Req
@enduml
